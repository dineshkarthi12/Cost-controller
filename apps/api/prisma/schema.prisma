// TOPROCK GLOBAL — Construction Cost Control Management System
// Conventions:
//   • Money: Decimal(18,2)   • Quantities / rates: Decimal(18,4)   • Fractions (pct): Decimal(9,6)
//   • Business dates use @db.Date; timestamps are timestamptz
//   • Statuses are strings validated by the API (see packages/shared/src/statuses.ts) so that
//     organisations can extend workflows without schema changes; fixed vocabularies use enums.
//   • Financial history is append-only (ledger, stock transactions, audit events).

generator client {
  provider      = "prisma-client-js"
  // native for local/Docker; rhel-openssl-3.0.x for Vercel serverless functions
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Organisation, users, access ─────────────────────────────

model Organisation {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  baseCurrency String   @default("INR")
  timezone     String   @default("Asia/Kolkata")
  settings     Json     @default("{}")
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users          User[]
  roles          Role[]
  projects       Project[]
  parties        Party[]
  materials      Material[]
  uoms           Uom[]
  equipment      Equipment[]
  docTypes       DocumentType[]
  workflows      WorkflowDefinition[]
  auditEvents    AuditEvent[]
  integrations   IntegrationConfig[]
  invitations    Invitation[]
  files          FileObject[]
  responsibility ResponsibilityAssignment[]
  checklistTpls  ChecklistTemplate[]
}

model User {
  id                String    @id @default(cuid())
  orgId             String
  email             String    @unique
  name              String
  employeeId        String?
  designation       String?
  department        String?
  phone             String?
  passwordHash      String?
  status            String    @default("ACTIVE") // ACTIVE | INVITED | DEACTIVATED
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?
  approvalLimit     Decimal?  @db.Decimal(18, 2)
  skills            String[]  @default([])
  responsibilities  String?
  reportingManagerId String?
  backupUserId      String?
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org              Organisation       @relation(fields: [orgId], references: [id])
  reportingManager User?              @relation("UserManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  reports          User[]             @relation("UserManager")
  backupUser       User?              @relation("UserBackup", fields: [backupUserId], references: [id], onDelete: SetNull)
  backupFor        User[]             @relation("UserBackup")
  roles            UserRole[]
  memberships      ProjectMember[]
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  notifications    Notification[]
  notificationPrefs NotificationPreference[]

  @@index([orgId])

  // generated back-relations
  rel_project_projectManager Project[] @relation("Project_projectManagerId")
  rel_project_createdBy Project[] @relation("Project_createdById")
  rel_budgetRevision_createdBy BudgetRevision[] @relation("BudgetRevision_createdById")
  rel_costLedgerEntry_createdBy CostLedgerEntry[] @relation("CostLedgerEntry_createdById")
  rel_costForecast_createdBy CostForecast[] @relation("CostForecast_createdById")
  rel_quantityTakeoff_createdBy QuantityTakeoff[] @relation("QuantityTakeoff_createdById")
  rel_measurement_createdBy Measurement[] @relation("Measurement_createdById")
  rel_measurementRevision_createdBy MeasurementRevision[] @relation("MeasurementRevision_createdById")
  rel_siteDiary_createdBy SiteDiary[] @relation("SiteDiary_createdById")
  rel_manpowerReport_createdBy ManpowerReport[] @relation("ManpowerReport_createdById")
  rel_attendanceRecord_createdBy AttendanceRecord[] @relation("AttendanceRecord_createdById")
  rel_fileObject_uploadedBy FileObject[] @relation("FileObject_uploadedById")
  rel_attachment_uploadedBy Attachment[] @relation("Attachment_uploadedById")
  rel_stockTransaction_createdBy StockTransaction[] @relation("StockTransaction_createdById")
  rel_materialIssue_createdBy MaterialIssue[] @relation("MaterialIssue_createdById")
  rel_stockCount_createdBy StockCount[] @relation("StockCount_createdById")
  rel_materialRequisition_requestedBy MaterialRequisition[] @relation("MaterialRequisition_requestedById")
  rel_purchaseRequisition_requestedBy PurchaseRequisition[] @relation("PurchaseRequisition_requestedById")
  rel_rfq_createdBy Rfq[] @relation("Rfq_createdById")
  rel_purchaseOrder_createdBy PurchaseOrder[] @relation("PurchaseOrder_createdById")
  rel_poRevision_createdBy PoRevision[] @relation("PoRevision_createdById")
  rel_grn_receivedBy Grn[] @relation("Grn_receivedById")
  rel_mir_createdBy Mir[] @relation("Mir_createdById")
  rel_supplierInvoice_createdBy SupplierInvoice[] @relation("SupplierInvoice_createdById")
  rel_expense_createdBy Expense[] @relation("Expense_createdById")
  rel_payment_createdBy Payment[] @relation("Payment_createdById")
  rel_subcontract_createdBy Subcontract[] @relation("Subcontract_createdById")
  rel_contractorBill_createdBy ContractorBill[] @relation("ContractorBill_createdById")
  rel_clientBill_createdBy ClientBill[] @relation("ClientBill_createdById")
  rel_creditNote_createdBy CreditNote[] @relation("CreditNote_createdById")
  rel_equipmentLog_createdBy EquipmentLog[] @relation("EquipmentLog_createdById")
  rel_equipmentMaintenance_createdBy EquipmentMaintenance[] @relation("EquipmentMaintenance_createdById")
  rel_contract_createdBy Contract[] @relation("Contract_createdById")
  rel_variation_createdBy Variation[] @relation("Variation_createdById")
  rel_claim_createdBy Claim[] @relation("Claim_createdById")
  rel_risk_owner Risk[] @relation("Risk_ownerId")
  rel_risk_createdBy Risk[] @relation("Risk_createdById")
  rel_inspection_createdBy Inspection[] @relation("Inspection_createdById")
  rel_ncr_createdBy Ncr[] @relation("Ncr_createdById")
  rel_safetyIncident_createdBy SafetyIncident[] @relation("SafetyIncident_createdById")
  rel_toolboxTalk_createdBy ToolboxTalk[] @relation("ToolboxTalk_createdById")
  rel_document_createdBy Document[] @relation("Document_createdById")
  rel_documentRevision_createdBy DocumentRevision[] @relation("DocumentRevision_createdById")
  rel_transmittal_createdBy Transmittal[] @relation("Transmittal_createdById")
  rel_rfi_createdBy Rfi[] @relation("Rfi_createdById")
  rel_task_owner Task[] @relation("Task_ownerId")
  rel_task_createdBy Task[] @relation("Task_createdById")
  rel_taskHandover_createdBy TaskHandover[] @relation("TaskHandover_createdById")
  rel_closeout_createdBy Closeout[] @relation("Closeout_createdById")
  rel_closeoutItem_owner CloseoutItem[] @relation("CloseoutItem_ownerId")
}

model Role {
  id          String   @id @default(cuid())
  orgId       String
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organisation     @relation(fields: [orgId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([orgId, code])
}

model Permission {
  code        String           @id
  area        String
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId         String
  permissionCode String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
}

/// Role assignment. projectId = null → organisation-wide; otherwise only for that project.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  projectId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, projectId])
  @@index([projectId])
}

model ProjectMember {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  projectRole   String?  // free-text designation on this project
  approvalLimit Decimal? @db.Decimal(18, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  mfaPending Boolean   @default(false)
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  name        String
  roleCodes   String[]
  projectIds  String[]
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId, email])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String
  userId       String
  route        String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([userId, key])
}

// ───────────────────────────── Parties, projects, structure ─────────────────────────────

/// Unified counterparty master: clients, consultants, suppliers, subcontractors.
model Party {
  id               String   @id @default(cuid())
  orgId            String
  code             String
  name             String
  kinds            String[] // CLIENT | CONSULTANT | SUPPLIER | SUBCONTRACTOR
  contactName      String?
  email            String?
  phone            String?
  address          String?
  taxId            String?
  registrationNo   String?
  bankDetails      String?
  paymentTermsDays Int?
  isApproved       Boolean  @default(false)
  rating           Decimal? @db.Decimal(4, 2)
  isActive         Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org Organisation @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId, name])

  // generated back-relations
  rel_project_client Project[] @relation("Project_clientId")
  rel_project_consultant Project[] @relation("Project_consultantId")
  rel_costLedgerEntry_party CostLedgerEntry[] @relation("CostLedgerEntry_partyId")
  rel_measurement_contractor Measurement[] @relation("Measurement_contractorId")
  rel_manpowerReport_contractor ManpowerReport[] @relation("ManpowerReport_contractorId")
  rel_worker_contractor Worker[] @relation("Worker_contractorId")
  rel_materialIssue_contractor MaterialIssue[] @relation("MaterialIssue_contractorId")
  rel_quotation_supplier Quotation[] @relation("Quotation_supplierId")
  rel_purchaseOrder_supplier PurchaseOrder[] @relation("PurchaseOrder_supplierId")
  rel_grn_supplier Grn[] @relation("Grn_supplierId")
  rel_supplierInvoice_supplier SupplierInvoice[] @relation("SupplierInvoice_supplierId")
  rel_expense_payee Expense[] @relation("Expense_payeeId")
  rel_payment_party Payment[] @relation("Payment_partyId")
  rel_subcontract_contractor Subcontract[] @relation("Subcontract_contractorId")
  rel_contractorBill_contractor ContractorBill[] @relation("ContractorBill_contractorId")
  rel_equipment_ownerParty Equipment[] @relation("Equipment_ownerPartyId")
  rel_contract_counterparty Contract[] @relation("Contract_counterpartyId")
  rel_claim_counterparty Claim[] @relation("Claim_counterpartyId")
  rel_ncr_contractor Ncr[] @relation("Ncr_contractorId")
  rel_transmittal_recipient Transmittal[] @relation("Transmittal_recipientId")
}

model Project {
  id                    String    @id @default(cuid())
  orgId                 String
  code                  String
  name                  String
  description           String?
  clientId              String?
  consultantId          String?
  location              String?
  projectManagerId      String?
  startDate             DateTime? @db.Date
  plannedCompletionDate DateTime? @db.Date
  actualCompletionDate  DateTime? @db.Date
  contractValue         Decimal   @default(0) @db.Decimal(18, 2)
  contractType          String    @default("LUMP_SUM") // LUMP_SUM | ITEM_RATE | COST_PLUS | DESIGN_BUILD | EPC
  currency              String    @default("INR")
  taxRate               Decimal   @default(0.18) @db.Decimal(9, 6)
  retentionPct          Decimal   @default(0.05) @db.Decimal(9, 6)
  advanceReceived       Decimal   @default(0) @db.Decimal(18, 2)
  advanceRecoveryPct    Decimal   @default(0) @db.Decimal(9, 6)
  reportingPeriod       String    @default("MONTHLY")
  status                String    @default("PLANNING")
  closeoutStatus        String    @default("NOT_STARTED")
  budgetBaselinedAt     DateTime?
  isDemo                Boolean   @default(false)
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org       Organisation    @relation(fields: [orgId], references: [id])
  members   ProjectMember[]
  userRoles UserRole[]

  @@unique([orgId, code])

  // generated foreign keys (scripts/add-relations.py)
  client Party? @relation("Project_clientId", fields: [clientId], references: [id], onDelete: Restrict)
  consultant Party? @relation("Project_consultantId", fields: [consultantId], references: [id], onDelete: Restrict)
  projectManager User? @relation("Project_projectManagerId", fields: [projectManagerId], references: [id], onDelete: Restrict)
  createdBy User? @relation("Project_createdById", fields: [createdById], references: [id], onDelete: Restrict)

  // generated back-relations
  rel_wbsNode_project WbsNode[] @relation("WbsNode_projectId")
  rel_costCode_project CostCode[] @relation("CostCode_projectId")
  rel_budgetLine_project BudgetLine[] @relation("BudgetLine_projectId")
  rel_budgetRevision_project BudgetRevision[] @relation("BudgetRevision_projectId")
  rel_costLedgerEntry_project CostLedgerEntry[] @relation("CostLedgerEntry_projectId")
  rel_costForecast_project CostForecast[] @relation("CostForecast_projectId")
  rel_reportingPeriod_project ReportingPeriod[] @relation("ReportingPeriod_projectId")
  rel_cashFlowPlan_project CashFlowPlan[] @relation("CashFlowPlan_projectId")
  rel_boqItem_project BoqItem[] @relation("BoqItem_projectId")
  rel_quantityTakeoff_project QuantityTakeoff[] @relation("QuantityTakeoff_projectId")
  rel_measurement_project Measurement[] @relation("Measurement_projectId")
  rel_activity_project Activity[] @relation("Activity_projectId")
  rel_progressEntry_project ProgressEntry[] @relation("ProgressEntry_projectId")
  rel_siteDiary_project SiteDiary[] @relation("SiteDiary_projectId")
  rel_manpowerReport_project ManpowerReport[] @relation("ManpowerReport_projectId")
  rel_worker_project Worker[] @relation("Worker_projectId")
  rel_attendanceRecord_project AttendanceRecord[] @relation("AttendanceRecord_projectId")
  rel_fileObject_project FileObject[] @relation("FileObject_projectId")
  rel_evidence_project Evidence[] @relation("Evidence_projectId")
  rel_attachment_project Attachment[] @relation("Attachment_projectId")
  rel_comment_project Comment[] @relation("Comment_projectId")
  rel_store_project Store[] @relation("Store_projectId")
  rel_stockTransaction_project StockTransaction[] @relation("StockTransaction_projectId")
  rel_materialIssue_project MaterialIssue[] @relation("MaterialIssue_projectId")
  rel_stockCount_project StockCount[] @relation("StockCount_projectId")
  rel_materialRequisition_project MaterialRequisition[] @relation("MaterialRequisition_projectId")
  rel_purchaseRequisition_project PurchaseRequisition[] @relation("PurchaseRequisition_projectId")
  rel_rfq_project Rfq[] @relation("Rfq_projectId")
  rel_purchaseOrder_project PurchaseOrder[] @relation("PurchaseOrder_projectId")
  rel_poRevision_project PoRevision[] @relation("PoRevision_projectId")
  rel_grn_project Grn[] @relation("Grn_projectId")
  rel_mir_project Mir[] @relation("Mir_projectId")
  rel_supplierInvoice_project SupplierInvoice[] @relation("SupplierInvoice_projectId")
  rel_expense_project Expense[] @relation("Expense_projectId")
  rel_payment_project Payment[] @relation("Payment_projectId")
  rel_subcontract_project Subcontract[] @relation("Subcontract_projectId")
  rel_contractorBill_project ContractorBill[] @relation("ContractorBill_projectId")
  rel_billingMilestone_project BillingMilestone[] @relation("BillingMilestone_projectId")
  rel_clientBill_project ClientBill[] @relation("ClientBill_projectId")
  rel_creditNote_project CreditNote[] @relation("CreditNote_projectId")
  rel_equipmentLog_project EquipmentLog[] @relation("EquipmentLog_projectId")
  rel_equipmentMaintenance_project EquipmentMaintenance[] @relation("EquipmentMaintenance_projectId")
  rel_contract_project Contract[] @relation("Contract_projectId")
  rel_variation_project Variation[] @relation("Variation_projectId")
  rel_claim_project Claim[] @relation("Claim_projectId")
  rel_risk_project Risk[] @relation("Risk_projectId")
  rel_inspection_project Inspection[] @relation("Inspection_projectId")
  rel_ncr_project Ncr[] @relation("Ncr_projectId")
  rel_safetyIncident_project SafetyIncident[] @relation("SafetyIncident_projectId")
  rel_toolboxTalk_project ToolboxTalk[] @relation("ToolboxTalk_projectId")
  rel_document_project Document[] @relation("Document_projectId")
  rel_documentRevision_project DocumentRevision[] @relation("DocumentRevision_projectId")
  rel_transmittal_project Transmittal[] @relation("Transmittal_projectId")
  rel_rfi_project Rfi[] @relation("Rfi_projectId")
  rel_task_project Task[] @relation("Task_projectId")
  rel_responsibilityAssignment_project ResponsibilityAssignment[] @relation("ResponsibilityAssignment_projectId")
  rel_workflowDefinition_project WorkflowDefinition[] @relation("WorkflowDefinition_projectId")
  rel_approvalRequest_project ApprovalRequest[] @relation("ApprovalRequest_projectId")
  rel_closeout_project Closeout[] @relation("Closeout_projectId")
}

model WbsNode {
  id        String   @id @default(cuid())
  projectId String
  parentId  String?
  code      String
  name      String
  level     Int      @default(1)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   WbsNode?   @relation("WbsTree", fields: [parentId], references: [id], onDelete: Restrict)
  children WbsNode[]  @relation("WbsTree")
  costCodes CostCode[]

  @@unique([projectId, code])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("WbsNode_projectId", fields: [projectId], references: [id], onDelete: Restrict)

  // generated back-relations
  rel_boqItem_wbsNode BoqItem[] @relation("BoqItem_wbsNodeId")
  rel_activity_wbsNode Activity[] @relation("Activity_wbsNodeId")
}

model CostCode {
  id          String   @id @default(cuid())
  projectId   String
  wbsNodeId   String?
  code        String
  name        String
  category    String   // LABOUR | MATERIAL | EQUIPMENT | SUBCONTRACT | OVERHEAD | OTHER
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wbsNode     WbsNode?          @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  budgetLine  BudgetLine?
  ledger      CostLedgerEntry[]

  @@unique([projectId, code])
  @@index([projectId, category])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("CostCode_projectId", fields: [projectId], references: [id], onDelete: Restrict)

  // generated back-relations
  rel_budgetRevisionLine_costCode BudgetRevisionLine[] @relation("BudgetRevisionLine_costCodeId")
  rel_costForecast_costCode CostForecast[] @relation("CostForecast_costCodeId")
  rel_boqItem_costCode BoqItem[] @relation("BoqItem_costCodeId")
  rel_activity_costCode Activity[] @relation("Activity_costCodeId")
  rel_manpowerLine_costCode ManpowerLine[] @relation("ManpowerLine_costCodeId")
  rel_stockTransaction_costCode StockTransaction[] @relation("StockTransaction_costCodeId")
  rel_materialIssue_costCode MaterialIssue[] @relation("MaterialIssue_costCodeId")
  rel_materialRequisition_costCode MaterialRequisition[] @relation("MaterialRequisition_costCodeId")
  rel_purchaseRequisition_costCode PurchaseRequisition[] @relation("PurchaseRequisition_costCodeId")
  rel_purchaseRequisitionLine_costCode PurchaseRequisitionLine[] @relation("PurchaseRequisitionLine_costCodeId")
  rel_purchaseOrderLine_costCode PurchaseOrderLine[] @relation("PurchaseOrderLine_costCodeId")
  rel_supplierInvoice_costCode SupplierInvoice[] @relation("SupplierInvoice_costCodeId")
  rel_supplierInvoiceLine_costCode SupplierInvoiceLine[] @relation("SupplierInvoiceLine_costCodeId")
  rel_expense_costCode Expense[] @relation("Expense_costCodeId")
  rel_subcontract_costCode Subcontract[] @relation("Subcontract_costCodeId")
  rel_equipmentLog_costCode EquipmentLog[] @relation("EquipmentLog_costCodeId")
  rel_variation_costCode Variation[] @relation("Variation_costCodeId")
  rel_ncr_costCode Ncr[] @relation("Ncr_costCodeId")
}

// ───────────────────────────── Budget, ledger, forecast, periods ─────────────────────────────

model BudgetLine {
  id                String   @id @default(cuid())
  projectId         String
  costCodeId        String   @unique
  originalAmount    Decimal  @default(0) @db.Decimal(18, 2)
  contingencyAmount Decimal  @default(0) @db.Decimal(18, 2)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  costCode CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)

  @@index([projectId])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("BudgetLine_projectId", fields: [projectId], references: [id], onDelete: Restrict)
}

/// Budget revision (net increase/decrease) or transfer (lines net to zero). Workflow controlled.
model BudgetRevision {
  id           String    @id @default(cuid())
  projectId    String
  number       String
  type         String    // REVISION | TRANSFER
  title        String
  reason       String
  variationId  String?
  totalDelta   Decimal   @default(0) @db.Decimal(18, 2)
  status       String    @default("DRAFT")
  approvedAt   DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines BudgetRevisionLine[]

  @@unique([projectId, number])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("BudgetRevision_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  createdBy User @relation("BudgetRevision_createdById", fields: [createdById], references: [id], onDelete: Restrict)
}

model BudgetRevisionLine {
  id         String  @id @default(cuid())
  revisionId String
  costCodeId String
  delta      Decimal @db.Decimal(18, 2)
  remarks    String?

  revision BudgetRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([costCodeId])

  // generated foreign keys (scripts/add-relations.py)
  costCode CostCode @relation("BudgetRevisionLine_costCodeId", fields: [costCodeId], references: [id], onDelete: Restrict)
}

enum LedgerKind {
  COMMITMENT
  ACCRUAL
  ACTUAL
}

/// Append-only cost ledger. Corrections are reversal entries.
model CostLedgerEntry {
  id           String     @id @default(cuid())
  projectId    String
  costCodeId   String
  periodId     String?
  date         DateTime   @db.Date
  kind         LedgerKind
  amount       Decimal    @db.Decimal(18, 2)
  category     String     // copied from cost code at posting
  sourceType   String     // PO | GRN | SUPPLIER_INVOICE | CONTRACTOR_BILL | EXPENSE | MPR | EQUIPMENT_LOG | SUBCONTRACT | PO_AMENDMENT
  sourceId     String
  sourceNumber String?
  partyId      String?
  description  String?
  reversalOfId String?
  createdById  String?
  createdAt    DateTime   @default(now())

  costCode CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)

  @@index([projectId, kind])
  @@index([projectId, costCodeId])
  @@index([projectId, date])
  @@index([sourceType, sourceId])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("CostLedgerEntry_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  party Party? @relation("CostLedgerEntry_partyId", fields: [partyId], references: [id], onDelete: Restrict)
  createdBy User? @relation("CostLedgerEntry_createdById", fields: [createdById], references: [id], onDelete: Restrict)
}

model CostForecast {
  id            String   @id @default(cuid())
  projectId     String
  costCodeId    String
  periodCode    String   // e.g. 2025-03
  method        String   // MANUAL | REMAINING_BUDGET | CPI
  uncommittedEtc Decimal @db.Decimal(18, 2)
  assumptions   String?
  eacSnapshot   Decimal? @db.Decimal(18, 2)
  createdById   String
  createdAt     DateTime @default(now())

  @@unique([projectId, costCodeId, periodCode])
  @@index([projectId, periodCode])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("CostForecast_projectId", fields: [projectId], references: [id], onDelete: Restrict)
