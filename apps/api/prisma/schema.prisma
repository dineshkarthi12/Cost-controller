  updatedAt      DateTime  @updatedAt

  @@unique([projectId, number])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("Transmittal_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  recipient Party? @relation("Transmittal_recipientId", fields: [recipientId], references: [id], onDelete: Restrict)
  createdBy User @relation("Transmittal_createdById", fields: [createdById], references: [id], onDelete: Restrict)
}

model Rfi {
  id             String    @id @default(cuid())
  projectId      String
  number         String
  kind           String    @default("RFI") // RFI | TECHNICAL_QUERY | SITE_INSTRUCTION
  subject        String
  question       String
  discipline     String?
  addressedTo    String?
  dueDate        DateTime? @db.Date
  response       String?
  respondedAt    DateTime?
  costImpact     Boolean   @default(false)
  scheduleImpact Boolean   @default(false)
  status         String    @default("OPEN") // OPEN | ANSWERED | CLOSED
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([projectId, number])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("Rfi_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  createdBy User @relation("Rfi_createdById", fields: [createdById], references: [id], onDelete: Restrict)
}

// ───────────────────────────── Tasks & team ─────────────────────────────

model Task {
  id             String    @id @default(cuid())
  projectId      String
  number         String
  title          String
  description    String?
  category       String    @default("GENERAL")
  relatedType    String?
  relatedId      String?
  ownerId        String?
  reviewerId     String?
  approverId     String?
  priority       String    @default("MEDIUM")
  startDate      DateTime? @db.Date
  dueDate        DateTime? @db.Date
  estimatedHours Decimal?  @db.Decimal(9, 2)
  actualHours    Decimal?  @db.Decimal(9, 2)
  status         String    @default("BACKLOG")
  checklist      Json      @default("[]")
  completionNote String?
  handoverNotes  String?
  recurrence     String?   // DAILY | WEEKLY | MONTHLY
  recurrenceParentId String?
  slaHours       Int?
  completedAt    DateTime?
  overdueNotifiedAt DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contributors TaskContributor[]
  dependencies TaskDependency[] @relation("TaskDeps")
  dependents   TaskDependency[] @relation("TaskDependents")
  handovers    TaskHandover[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([ownerId, status])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("Task_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  owner User? @relation("Task_ownerId", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy User @relation("Task_createdById", fields: [createdById], references: [id], onDelete: Restrict)
}

model TaskContributor {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

model TaskHandover {
  id         String   @id @default(cuid())
  taskId     String
  fromUserId String?
  toUserId   String
  notes      String?
  createdById String
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // generated foreign keys (scripts/add-relations.py)
  createdBy User @relation("TaskHandover_createdById", fields: [createdById], references: [id], onDelete: Restrict)
}

/// Editable RACI / responsibility matrix per process (document type) and optional project.
model ResponsibilityAssignment {
  id               String   @id @default(cuid())
  orgId            String
  projectId        String?
  processType      String
  responsibleId    String?
  accountableId    String?
  reviewerId       String?
  approverId       String?
  backupId         String?
  slaHours         Int?
  escalationUserId String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org Organisation @relation(fields: [orgId], references: [id])

  @@unique([orgId, projectId, processType])

  // generated foreign keys (scripts/add-relations.py)
  project Project? @relation("ResponsibilityAssignment_projectId", fields: [projectId], references: [id], onDelete: Restrict)
}

// ───────────────────────────── Workflow & approvals ─────────────────────────────

model WorkflowDefinition {
  id                String   @id @default(cuid())
  orgId             String
  projectId         String?
  docType           String
  name              String
  isActive          Boolean  @default(true)
  allowSelfApproval Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org   Organisation   @relation(fields: [orgId], references: [id])
  steps WorkflowStep[]

  @@unique([orgId, projectId, docType])

  // generated foreign keys (scripts/add-relations.py)
  project Project? @relation("WorkflowDefinition_projectId", fields: [projectId], references: [id], onDelete: Restrict)

  // generated back-relations
  rel_approvalRequest_definition ApprovalRequest[] @relation("ApprovalRequest_definitionId")
}

model WorkflowStep {
  id                String   @id @default(cuid())
  definitionId      String
  stepNo            Int
  name              String
  approverRoleCode  String?
  approverUserId    String?
  minAmount         Decimal? @db.Decimal(18, 2)
  maxAmount         Decimal? @db.Decimal(18, 2)
  requiredApprovals Int      @default(1)
  slaHours          Int      @default(48)
  escalateToRoleCode String?

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, stepNo])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model ApprovalRequest {
  id             String         @id @default(cuid())
  orgId          String
  projectId      String
  docType        String
  entityId       String
  entityNumber   String?
  title          String
  amount         Decimal?       @db.Decimal(18, 2)
  definitionId   String
  steps          Json           // resolved applicable steps at submission
  currentStepNo  Int
  stepStartedAt  DateTime       @default(now())
  status         ApprovalStatus @default(PENDING)
  submittedById  String
  submittedAt    DateTime       @default(now())
  completedAt    DateTime?
  escalatedAt    DateTime?
  activeKey      String?        @unique // "<docType>:<entityId>" while pending — one active request per document

  actions ApprovalAction[]

  @@index([projectId, status])
  @@index([docType, entityId])

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("ApprovalRequest_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  definition WorkflowDefinition @relation("ApprovalRequest_definitionId", fields: [definitionId], references: [id], onDelete: Restrict)
}

model ApprovalAction {
  id           String   @id @default(cuid())
  requestId    String
  stepNo       Int
  actorId      String
  onBehalfOfId String?
  action       String   // SUBMIT | APPROVE | REJECT | RETURN | ESCALATE | CANCEL | COMMENT
  comment      String?
  createdAt    DateTime @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Delegation {
  id         String   @id @default(cuid())
  orgId      String
  fromUserId String
  toUserId   String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  docTypes   String[] @default([])
  reason     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([toUserId])
}

// ───────────────────────────── Numbering, register, notifications, audit ─────────────────────────────

model DocumentType {
  id                  String  @id @default(cuid())
  orgId               String
  code                String
  name                String
  abbreviation        String
  numberFormat        String
  resetPolicy         String  @default("NEVER")
  requiredAttachments Int     @default(0)
  isActive            Boolean @default(true)

  org Organisation @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
}

model NumberSequence {
  id        String @id @default(cuid())
  orgId     String
  docType   String
  scopeKey  String
  lastValue Int    @default(0)

  @@unique([orgId, docType, scopeKey])
}

/// Cross-module document register. Numbers are unique per organisation.
model RegisterEntry {
  id         String   @id @default(cuid())
  orgId      String
  projectId  String?
  docType    String
  number     String
  entityType String
  entityId   String
  title      String?
  status     String?
  ownerId    String?
  amount     Decimal? @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, number])
  @@unique([entityType, entityId])
  @@index([projectId, docType])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  projectId  String?
  type       String
  title      String
  body       String?
  link       String?
  entityType String?
  entityId   String?
  dedupeKey  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model NotificationPreference {
  id     String  @id @default(cuid())
  userId String
  type   String
  inApp  Boolean @default(true)
  email  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

/// Append-only audit trail.
model AuditEvent {
  id         String   @id @default(cuid())
  orgId      String
  projectId  String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@index([projectId, createdAt])
}

model IntegrationConfig {
  id             String    @id @default(cuid())
  orgId          String
  provider       String
  kind           String    // ACCOUNTING | ERP | PAYROLL | EMAIL | STORAGE | SCHEDULING
  status         String    @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONFIGURED_UNTESTED | ACTIVE | ERROR
  config         Json      @default("{}")
  lastTestAt     DateTime?
  lastTestResult String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org Organisation @relation(fields: [orgId], references: [id])

  @@unique([orgId, provider])
}

model ImportJob {
  id          String    @id @default(cuid())
  orgId       String
  projectId   String?
  kind        String    // BOQ | MATERIALS | SUPPLIERS | OPENING_STOCK | COST_CODES
  fileName    String
  status      String    @default("PREVIEW") // PREVIEW | COMMITTED | CANCELLED | FAILED
  mapping     Json      @default("{}")
  rows        Json      @default("[]")
  summary     Json      @default("{}")
  createdById String
  committedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ───────────────────────────── Closeout ─────────────────────────────

model Closeout {
  id             String    @id @default(cuid())
  projectId      String    @unique
  status         String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | APPROVED | ARCHIVED | RETURNED | REJECTED
  lessonsLearned String?
  finalSnapshot  Json?
  approvedAt     DateTime?
  archivedAt     DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items CloseoutItem[]

  // generated foreign keys (scripts/add-relations.py)
  project Project @relation("Closeout_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  createdBy User @relation("Closeout_createdById", fields: [createdById], references: [id], onDelete: Restrict)
}

model CloseoutItem {
  id          String    @id @default(cuid())
  closeoutId  String
  key         String
  label       String
  status      String    @default("PENDING") // PENDING | DONE | NOT_APPLICABLE
  ownerId     String?
  note        String?
  completedAt DateTime?

  closeout Closeout @relation(fields: [closeoutId], references: [id], onDelete: Cascade)

  @@unique([closeoutId, key])

  // generated foreign keys (scripts/add-relations.py)
  owner User? @relation("CloseoutItem_ownerId", fields: [ownerId], references: [id], onDelete: Restrict)
}
