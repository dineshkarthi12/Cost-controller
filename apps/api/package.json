{
  "name": "@toprock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "SEED_MODE=true tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@toprock/shared": "*",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "mailparser": "^3.12.4",
    "prisma": "6.19.3",
    "smtp-server": "^3.21.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
