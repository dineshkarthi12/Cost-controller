# Copy to .env and adjust. Never commit real credentials.
DATABASE_URL="postgresql://toprock:toprock@localhost:5432/toprock"
TEST_DATABASE_URL="postgresql://toprock:toprock@localhost:5432/toprock_test"
# Playwright e2e database (name must end in _e2e; it is truncated and re-seeded each run)
E2E_DATABASE_URL="postgresql://toprock:toprock@localhost:5432/toprock_e2e"
NODE_ENV=development
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Session lifetime in hours (idle sessions expire after SESSION_IDLE_HOURS)
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=4
COOKIE_SECURE=false
# Storage: local | s3 (s3 adapter is an interface only — not active)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
# Email transport is not active until configured; messages are logged.
SMTP_URL=
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info
# Password for seeded users. Required (min. 12 chars) when NODE_ENV=production.
SEED_PASSWORD=
# Set SEED_DEMO=false to create only reference data and the admin user.
SEED_DEMO=true
# Vercel only: Blob store token (added automatically when a Blob store is connected) and
# the secret Vercel Cron sends to /api/cron/jobs (set any long random string).
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
