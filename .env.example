# Copy to .env and adjust. Never commit real credentials.
DATABASE_URL="postgresql://toprock:toprock@localhost:5432/toprock"
TEST_DATABASE_URL="postgresql://toprock:toprock@localhost:5432/toprock_test"
NODE_ENV=development
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Session lifetime in hours (idle sessions expire after SESSION_IDLE_HOURS)
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=4
COOKIE_SECURE=false
# Storage: local | s3 (s3 adapter is an interface only — not active)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
# Email transport is not active until configured; messages are logged.
SMTP_URL=
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info
